# UNIQUE Bank — Environment Variables
# Copy this file to .env and fill in appropriate values.
# Never commit .env to version control.

# Vite exposes variables prefixed with VITE_ to the client bundle.
# Do NOT place private API keys or secrets here — they would be visible in the browser.

VITE_APP_TITLE=UNIQUE Bank
VITE_API_BASE_URL=http://localhost:3001/api
